MONGODB_URI=mongodb://localhost:27017/serv_desenvolvimento?replicaSet=rs0
PORT=3000
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=7d
# Banco exclusivo para desenvolvimento; em produção use o nome do banco de produção.
MONGODB_DB_NAME=serv_desenvolvimento
# true para servir o React junto com a API Spring Boot.
SERVE_FRONTEND=false
FRONTEND_PATH=../frontend/dist
# Origens extras autorizadas; em produção configure o domínio real.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Configure limites por IP também no ingress/WAF quando houver proxy ou múltiplas instâncias.
