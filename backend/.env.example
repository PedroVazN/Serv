MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/serv?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
# true para servir o build React junto com a API (Docker de produção já configura).
SERVE_FRONTEND=false
# Origens extras autorizadas; em produção configure o domínio real.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Opcional: IPs/sub-redes confiáveis do proxy, separados por vírgula.
# Defina conforme a arquitetura da hospedagem; não aceite cabeçalhos de qualquer IP.
TRUST_PROXY=
